{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/inject-latest-alert-summary.sh"
          }
        ]
      }
    ]
  },
  "extraKnownMarketplaces": {
    "ai-agents-local": {
      "source": {
        "source": "directory",
        "path": "."
      }
    }
  },
  "enabledPlugins": {
    "pikud-alerts-suite@ai-agents-local": true,
    "tzevaadom-alerts-suite@ai-agents-local": true,
    "markdown-suite@ai-agents-local": true,
    "word-to-pdf-suite@ai-agents-local": true
  }
}
